```mermaid
erDiagram
    products ||--o{ transaction_items : "referenced_in"
    transactions ||--|{ transaction_items : "contains"
    expenses {
        UUID id PK
        DATE expense_date
        VARCHAR category
        NUMERIC amount
        TEXT notes
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    products {
        UUID id PK
        VARCHAR name
        VARCHAR category
        NUMERIC cost_price
        NUMERIC selling_price
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    transactions {
        UUID id PK
        VARCHAR invoice_number UK
        NUMERIC total_revenue
        NUMERIC total_cogs
        NUMERIC gross_profit
        VARCHAR payment_method
        TEXT notes
        TIMESTAMPTZ created_at
    }
    transaction_items {
        UUID id PK
        UUID transaction_id FK
        UUID product_id FK
        VARCHAR product_name
        INT quantity
        NUMERIC cost_price
        NUMERIC selling_price
        NUMERIC subtotal_revenue
        NUMERIC subtotal_cogs
        NUMERIC subtotal_profit
        TIMESTAMPTZ created_at
    }
```
